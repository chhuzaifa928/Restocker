# ReStock AI — environment variables (names only; NEVER commit real values)

# LLM explanation layer. If LLM_API_KEY is empty, the app uses a deterministic
# templated rationale and still works end-to-end (graceful degradation).
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=                    # set in the cloud dashboard, never in git
LLM_MODEL=                      # optional override (defaults chosen per provider)
LLM_TIMEOUT=5.0

# Dual-gate constants (SRS Section 6). Defaults are sensible; override to taste.
AUTO_LIMIT=5000
HARD_LIMIT=12000
MAX_ORDER_QTY=400
CONF_THRESHOLD=0.60
MIN_VISITS_FAMILIAR=5

# --- Integrations (all optional; the app works fully without them) ---------

# Persistence. SQLite file path; state (decisions, budget, feedback) survives a
# redeploy. Set DB_PATH empty to run pure in-memory (original MVP behaviour).
DB_PATH=data/restock.db

# Escalation notifications. A Discord (or Slack-compatible) incoming webhook.
# Escalated orders are pushed here with one-click Approve/Reject links.
NOTIFY_DISCORD_WEBHOOK_URL=

# Order fulfillment. If set, every executed order POSTs a purchase-order receipt
# to this URL (supplier intake, Google Sheet Apps Script, n8n/Zapier hook, …).
PURCHASE_ORDER_WEBHOOK_URL=

# Public URL of THIS service, used to build the Approve/Reject links in Discord.
# Set it to your Alternate Clouds URL after the first deploy.
PUBLIC_BASE_URL=

# Timeout (seconds) for the notification / fulfillment webhook calls.
WEBHOOK_TIMEOUT=5.0

# Demand-signal ingestion. If set, POST /api/ingest pulls fresh demand numbers
# from this JSON endpoint ([{"product_id": "...", "demand_forecast": 320}, ...]).
# Leave empty to use the built-in mock sales feed (no config needed).
DEMAND_SIGNAL_URL=
