# ReStock AI — environment variables (names only; NEVER commit real values)

# LLM explanation layer. If LLM_API_KEY is empty, the app uses a deterministic
# templated rationale and still works end-to-end (graceful degradation).
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=                    # set in the cloud dashboard, never in git
LLM_MODEL=                      # optional override (defaults chosen per provider)
LLM_TIMEOUT=5.0

# Dual-gate constants (SRS Section 6). Defaults are sensible; override to taste.
AUTO_LIMIT=5000
HARD_LIMIT=12000
MAX_ORDER_QTY=400
CONF_THRESHOLD=0.60
MIN_VISITS_FAMILIAR=5
